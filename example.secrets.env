# ── Proxmox ──────────────────────────────────────────────────────────────────
PROXMOX_PASSWORD=pass
PROXMOX_NODE=f99-hv00
PROXMOX_NODE_IP=192.168.0.27
PROXMOX_HOST=https://192.168.0.27:8006
PROXMOX_USERNAME=root@pam
STORAGE_POOL=zfs-ssd

# ── Windows ISO paths (в Proxmox storage) ───────────────────────────────────
# Для Windows 11:       WIN_ISO=local:iso/Win11_23H2_x64.iso
# Для WinServer 2022:   WIN_ISO=local:iso/WinServer2022.iso
# Для WinServer 2025:   WIN_ISO=local:iso/WinServer2025.iso
WIN_ISO=f06-iso:Win11_Russian_x64.iso
VIRTIO_ISO=f06-iso:iso/virtio-win-0.1.285.iso

# ── Windows admin password ───────────────────────────────────────────────────
WIN_PASSWORD=pass

# ── Packer template ──────────────────────────────────────────────────────────
TEMPLATE_ID=9010

# ── VM параметры (Terraform) ─────────────────────────────────────────────────
VM_COUNT=2
VM_ID=132000
VM_NAME=win11-packer
VM_CORES=4
VM_MEMORY=4096
VM_DISK_SIZE=60
VM_TAGS=["win","srv","pta"]

# ── Network ──────────────────────────────────────────────────────────────────
VLAN_ID=9
DNS_DOMAIN=sadkomed.local
DHCP=true
IP_ADDRESS=192.168.9.90/24
IP_GATEWAY=192.168.9.254
